root = true

[*.{h,hpp,hxx,c,cc,cpp,cxx,inl}]
indent_style = tab
indent_size = 4
end_of_line = crlf
insert_final_newline = true
charset = utf-8-bom

# VS C++ formatting (requires "Use .editorconfig" enabled)
# Allman style braces: place opening braces on a new line
# https://learn.microsoft.com/cpp/ide/editorconfig-settings-reference

# Namespace, class, method, control blocks
csharp_new_line_before_open_brace = all
cpp_new_line_before_open_brace_namespace = true
cpp_new_line_before_open_brace_type = true
cpp_new_line_before_open_brace_function = true
cpp_new_line_before_open_brace_block = true

# Spaces and wrapping
cpp_space_before_function_open_parenthesis = remove
cpp_space_within_parens = false
cpp_space_before_square_brackets = false
cpp_space_between_empty_parens = false
cpp_space_around_operators = insert
cpp_wrap_preserve_blocks = one_liner

# Keep includes unsorted (respect existing order)
cpp_sort_includes = false
